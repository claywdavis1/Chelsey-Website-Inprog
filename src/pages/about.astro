---
import Layout from "../layouts/Layout.astro";
import { aboutPageContent } from "../config";
---

<style>
	h1 {font-family: 'Edelsans', sans-serif;}
</style>
<Layout seo={aboutPageContent.seo}>
	<section class="mt-10 max-w-4xl mx-auto px-6">
	  <!-- Page heading -->
	  <h1 class="text-2xl mb-5">{aboutPageContent.subtitle}</h1>

	  {
		aboutPageContent.sections.map((section) => (
		  <div class="mb-0">
			{section.heading && (
			  <h2 class="text-2xl opacity-60 mb-4">{section.heading}</h2>
			)}

			{section.subheading && (
			  <p class="font-bold mb-3">{section.subheading}</p>
			)}

			{/* Inset photo — paragraphs wrap around it on wider screens */}
			{section.image && (
			  <img
				src={section.image.url}
				alt={section.image.alt}
				class="w-full sm:w-56 sm:float-right sm:ml-6 mb-4 rounded-lg object-cover"
			  />
			)}

			{section.paragraphs.map((paragraph) => (
			  <p class="mb-4 last:mb-0">{paragraph}</p>
			))}

			<div class="clear-both"></div>
		  </div>
		))
	  }
	</section>
</Layout>
