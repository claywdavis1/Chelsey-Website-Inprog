---
import Layout from "../layouts/Layout.astro";
import { nofoPageContent } from "../config";
---

<style>
	h1 {font-family: 'Edelsans', sans-serif;}
</style>
<Layout seo={nofoPageContent.seo}>
	<section class="mt-10 max-w-4xl mx-auto px-6">
	  <!-- Page heading -->
	  <h1 class="text-2xl mb-10">{nofoPageContent.subtitle}</h1>

	  <div class="flex flex-col gap-10">
		{
		  nofoPageContent.sections.map((section) => (
			<div>
			  <h2 class="mb-2">
				<a
				  href={section.url}
				  target={section.external ? "_blank" : "_self"}
				  rel={section.external ? "noopener noreferrer" : undefined}
				  class="text-xl font-bold underline underline-offset-4 hover:opacity-60 transition-opacity"
				>
				  {section.heading}
				</a>
			  </h2>
			  <p>{section.text}</p>
			</div>
		  ))
		}
	  </div>
	</section>
</Layout>
