---
import Layout from "../layouts/Layout.astro";
import { servicesPageContent } from "../config";
---

<style>
	h1 {font-family: 'Edelsans', sans-serif;}

	/* Hide the default disclosure triangle in favour of our own indicator. */
	summary::-webkit-details-marker {
		display: none;
	}
</style>
<Layout seo={servicesPageContent.seo}>
	<section class="mt-10 max-w-4xl mx-auto px-6">
	  <!-- Page heading -->
	  <h1 class="text-2xl mb-5">{servicesPageContent.subtitle}</h1>

	  <!-- Intro paragraph -->
	  <p class="mb-10">{servicesPageContent.description}</p>

	  <!-- Collapsible service sections -->
	  <div class="border-t border-black/10">
		{
		  servicesPageContent.services.map((service) => (
			<details class="group border-b border-black/10">
			  <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 font-bold text-lg">
				{service.heading}
				<span class="shrink-0 opacity-60 transition-transform duration-300 group-open:rotate-45">
				  +
				</span>
			  </summary>
			  <div class="pb-6">
				<p class="mb-3 last:mb-0">{service.description}</p>
				{service.items && (
				  <ul class="list-disc pl-6 space-y-1">
					{service.items.map((item) => (
					  <li>{item}</li>
					))}
				  </ul>
				)}
			  </div>
			</details>
		  ))
		}
	  </div>

	  <!-- Call to action -->
	  <a
		href={servicesPageContent.button.url}
		target={servicesPageContent.button.external ? "_blank" : "_self"}
		class="inline-block mt-10 px-5 py-2.5 rounded-lg bg-gray-bg !text-white hover:opacity-70 transition-opacity"
	  >
		{servicesPageContent.button.title}
	  </a>
	</section>
</Layout>
