---
import Layout from "../layouts/Layout.astro";
import { homePageContent, identity } from "../config";

import Link from "../components/Link.astro";
import FeatureSection from "../components/FeatureSection.astro";
---

<style>
	h1 {font-family: 'Edelsans', sans-serif;}
</style>
  <Layout seo={homePageContent.seo}>
	<section class="mt-10 max-w-4xl mx-auto px-6">
	  <!-- Title -->
   
	  <h1 class="text-3xl mb-1">{homePageContent.title}</h1>
  
	  <!-- Description -->
	  <p class="opacity-60 mb-10">{homePageContent.role}</p>
	  
	  <!-- Homepage Text -->
	  <div class="mb-14">
		<Fragment set:html={homePageContent.description} />
	  </div>

	  <!-- Feature sections: photo left, heading + text + button right -->
	  <div class="flex flex-col gap-14 mb-14">
		{
		  homePageContent.features.map((feature) => (
			<FeatureSection {...feature} />
		  ))
		}
	  </div>
	  <!-- <p class="max-w-md mb-14">
		{homePageContent.description}
	  </p> -->

	  
	  
	</section>
	
  </Layout>


